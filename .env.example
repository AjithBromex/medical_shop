# Oscar Pharma - Environment Variables Example Template
# Copy to .env for local configuration if needed. Never commit actual secret keys.

# Google OAuth2 Client ID for Web / Desktop
# For Android: OAuth client is configured via Package Name (com.ajithbromex.medical_shop_manager) and SHA-1 in Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_if_desktop

# Local Environment Mode (development / staging / production)
APP_ENV=production

